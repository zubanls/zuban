[case no_stack_overflow_on_walrus_with_recursive_typed_dict_in_list]
# From the altair project (https://github.com/vega/altair), where
# `if func := theme.get():` crashed with a stack overflow.
from typing import Any, TypedDict

class Merged(TypedDict):
    between: Merged | Any

x: list[Merged] | None
if y := x:
    pass

[case no_stack_overflow_on_generic_recursive_alias_with_any_after_narrowing]
# From the xarray project (https://github.com/pydata/xarray), where
# `NestedDict[FromDictDataValue] | None` crashed with a stack overflow in
# `DataTree.from_dict`.
from typing import Any

type NestedDict[T] = dict[str, NestedDict[T] | T]

def f(data: NestedDict[Any] | None):
    if data is None:
        data = {}
