[case no_crash_on_named_tuple_base_class]
# From GH #644
from typing import NamedTuple, Sequence

def f():
    pass

class C(Sequence, NamedTuple, f):  # E: NamedTuple should be a single base \
                                   # E: Invalid base class "f" \
                                   # E: Cannot determine consistent method resolution order (MRO) for "C"
    def m(self):
        pass

class C2(Sequence, NamedTuple):  # E: NamedTuple should be a single base \
                                 # E: Cannot determine consistent method resolution order (MRO) for "C2"
    def m(self):
        pass
