[case github_issue_295_annotated_variable_after_match]
from typing import Any, Generic, TypeVar

T = TypeVar("T")

class ColumnElement(Generic[T]): ...
class Label(ColumnElement[T]): ...

def asc(column: ColumnElement[float]) -> None: ...

def reproduce(order: int) -> None:
    sort_column: ColumnElement[Any]
    reveal_type(sort_column)  # N: Revealed type is "__main__.ColumnElement[Any]"
    asc(sort_column)
    match order:
        case 0:
            sort_column = Label[float]()
        case _:
            sort_column = Label[None]()

    reveal_type(sort_column)  # N: Revealed type is "__main__.Label[builtins.float] | __main__.Label[None]"
    asc(sort_column)  # E: Argument 1 to "asc" has incompatible type "Label[float] | Label[None]"; expected "ColumnElement[float]"
