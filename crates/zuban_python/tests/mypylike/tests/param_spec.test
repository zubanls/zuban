[case param_spec_with_generics]
from typing import Callable, TypeVar, Generic
from typing_extensions import ParamSpec

_P = ParamSpec("_P")
_T = TypeVar("_T")

class Job(Generic[_P, _T]):
    def __init__(self, target: Callable[_P, _T]) -> None: ...
    def into_callable(self) -> Callable[_P, _T]: ...

def generic_f(x: _T) -> _T: ...

j = Job(generic_f)
reveal_type(j)  # N: Revealed type is "__main__.Job[[x: _T], _T]"

jf = j.into_callable()
reveal_type(jf)  # N: Revealed type is "def [_T] (x: _T) -> _T"
reveal_type(jf(1))  # N: Revealed type is "Literal[1]?"
reveal_type(jf(""))  # N: Revealed type is "Literal['']?"

[case param_spec_with_generics_combined]
from typing import Callable, TypeVar, Generic
from typing_extensions import ParamSpec, Concatenate

_P = ParamSpec("_P")
_T = TypeVar("_T")
_U = TypeVar("_U")

class Job(Generic[_P, _T]):
    def __init__(self, target: Callable[_P, _T]) -> None: ...
    def into_callable(self) -> Callable[Concatenate[_U, _P], tuple[_U, list[_T]]]: ...

def generic_f(x: _T) -> _T: ...

j = Job(generic_f)
reveal_type(j)  # N: Revealed type is "__main__.Job[[x: _T], _T]"

jf = j.into_callable()
reveal_type(jf)  # N: Revealed type is "def [_U, _T] (_U, x: _T) -> tuple[_U, list[_T]]"
reveal_type(jf(1.0, 1))  # N: Revealed type is "tuple[float, list[int]]"
reveal_type(jf(1, ""))  # N: Revealed type is "tuple[int, list[str]]"

[case param_spec_with_generic_class]
from typing import Callable, TypeVar, Generic
from typing_extensions import ParamSpec, Concatenate

_P = ParamSpec("_P")
_T = TypeVar("_T")
_U = TypeVar("_U")

class Job(Generic[_P, _T]):
    def __init__(self, target: Callable[_P, _T]) -> None: ...
    def into_callable(self) -> Callable[Concatenate[_U, _P], tuple[_U, list[_T]]]: ...

class X(Generic[_T]):
    def __init__(self, y: set[_T]): ...

j = Job(X)
reveal_type(j)  # N: Revealed type is "__main__.Job[[y: set[_T]], __main__.X[_T]]"

jf = j.into_callable()
reveal_type(jf)  # N: Revealed type is "def [_U, _T] (_U, y: set[_T]) -> tuple[_U, list[__main__.X[_T]]]"
reveal_type(jf(1.0, {1}))  # N: Revealed type is "tuple[float, list[__main__.X[int]]]"
reveal_type(jf(1, {""}))  # N: Revealed type is "tuple[int, list[__main__.X[str]]]"

[case param_spec_with_identity_mypy_issue_12278]
from typing import Callable, ParamSpec, TypeVar

T = TypeVar("T")

P = ParamSpec("P")
R = TypeVar("R")

def call(f: Callable[P, R], *args: P.args, **kwargs: P.kwargs) -> R:
    return f(*args, **kwargs)

def identity(x: T) -> T:
    return x

call(identity, 2)  # error: Argument 2 to "call" has incompatible type "int"; expected "T"

y: int = call(identity, 2)

[case param_spec_aesthetic]
from typing import Generic, ParamSpec

P = ParamSpec("P")

class Z(Generic[P]): ...

t1: Z[int]
t2: Z[bytes, str]
reveal_type(t1)  # N: Revealed type is "__main__.Z[[int]]"
reveal_type(t2)  # N: Revealed type is "__main__.Z[[bytes, str]]"

[case alias_applying_param_spec]
# Similar to testConcatDeferralNoCrash
from typing import Callable, TypeVar
from typing_extensions import Concatenate, ParamSpec

P = ParamSpec("P")

Alias = Callable[P, bool]

def test(f: Alias[Concatenate[int, P]]) -> Callable[P, float]: ...

x: Callable[[int, int], bool]
y: Callable[[int, int, str], bool]
z: Callable[[int], bool]
reveal_type(test(x))  # N: Revealed type is "def (int) -> float"
reveal_type(test(y))  # N: Revealed type is "def (int, str) -> float"
reveal_type(test(z))  # N: Revealed type is "def () -> float"

f: Callable[[str], bool]
g: Callable[[int], str]
test(f)  # E: Argument 1 to "test" has incompatible type "Callable[[str], bool]"; expected "Callable[[int], bool]"
test(g)  # E: Argument 1 to "test" has incompatible type "Callable[[int], str]"; expected "Callable[[int], bool]"

[case more_invalid_param_spec_calls]
from typing import Callable, TypeVar, ParamSpec

P = ParamSpec("P")

def test(f: Callable[P, int], *args: P.args, **kwargs: P.kwargs) -> None:
    test(f, *args)  # E: ParamSpec arguments must be of types "*P.args, **P.kwargs"
    test(f, **args) # E: Argument after ** must be a mapping, not "P.args"

[case more_invalid_param_spec_calls_with_additional_unpack]
from typing import Callable, TypeVar, ParamSpec

P = ParamSpec("P")

with_unpack: tuple[int, *tuple[int, ...]] = (1,)

def test(f: Callable[P, int], *args: P.args, **kwargs: P.kwargs) -> None:
    test(f, *args, *with_unpack)  # E: ParamSpec arguments must be of types "*P.args, **P.kwargs"
    test(f, *with_unpack, *args)  # E: ParamSpec arguments must be of types "*P.args, **P.kwargs" \
                                  # E: Argument 2 to "test" has incompatible type "*tuple[int, Unpack[Tuple[int, ...]]]"; expected "P.args"
    test(f, *with_unpack)  # E: Argument 2 to "test" has incompatible type "*tuple[int, Unpack[Tuple[int, ...]]]"; expected "P.args"
    test(f, *with_unpack, **kwargs)  # E: Argument 2 to "test" has incompatible type "*tuple[int, Unpack[Tuple[int, ...]]]"; expected "P.args" \
                                     # E: Argument 3 to "test" has incompatible type "**P.kwargs"; expected "P.kwargs"

[case param_spec_with_invalid_arg_between]
from typing import ParamSpec
P = ParamSpec("P")

def foo(*args: P.args, x: int, **kwargs: P.kwargs): ...  # E: Arguments not allowed after ParamSpec.args  # E: ParamSpec "P" is unbound

foo(1, 2, 3, 4)

[case param_spec_against_any]
from typing_extensions import ParamSpec
from typing import Callable, Any

P = ParamSpec("P")

def with_any(*args: Any, **kwargs: Any) -> None: ...

def run(func: Callable[P, None], *args: P.args, **kwargs: P.kwargs):
    func(*args, **kwargs)
    with_any(*args, **kwargs)

    def with_args_any(*args: int, **kwargs: Any) -> None: ...
    def with_any_kwargs(*args: Any, **kwargs: int) -> None: ...
    def with_args_kwargs(*args: str, **kwargs: int) -> None: ...

    with_args_any(
        *args,  # E: Argument 1 to "with_args_any" has incompatible type "*P.args"; expected "int"
        **kwargs
    )
    with_any_kwargs(
        *args,
        **kwargs  # E: Argument 2 to "with_any_kwargs" has incompatible type "**P.kwargs"; expected "int"
    )
    with_args_kwargs(
        *args,  # E: Argument 1 to "with_args_kwargs" has incompatible type "*P.args"; expected "str"
        **kwargs  # E: Argument 2 to "with_args_kwargs" has incompatible type "**P.kwargs"; expected "int"
    )

[case param_spec_any_inheritance]
from typing import ParamSpec, Generic, Callable
_P = ParamSpec("_P")

class C(Generic[_P]):
    def __init__(self, func: Callable[_P, None], /, *args: _P.args, **kwargs: _P.kwargs) -> None: ...

class D(C):
    pass

def f(x: str) -> None: ...
D(f, 1)
D(f, '')

[case param_invalid_usages_in_sub_funcs]
# Copied from conformance tests (generics_paramspec_components.py)
from typing import ParamSpec, Callable, Any
P = ParamSpec("P")
def puts_p_into_scope1(f: Callable[P, int]) -> None:
    def inner(*args: P.args, **kwargs: P.kwargs) -> None:  # OK
        pass

    def mixed_up(*args: P.kwargs, **kwargs: P.args) -> None:  # E: Use "P.args" for variadic "*" parameter  # E: Use "P.kwargs" for variadic "**" parameter
        pass

    def misplaced1(x: P.args) -> None:  # E: ParamSpec components are not allowed here
        pass

    def bad_kwargs1(*args: P.args, **kwargs: P.args) -> None:  # E: Use "P.kwargs" for variadic "**" parameter
        pass

    def bad_kwargs2(*args: P.args, **kwargs: Any) -> None:  # E: ParamSpec must have "*args" typed as "P.args" and "**kwargs" typed as "P.kwargs"
        pass

[case param_spec_as_self]
# From GH #259
class C[T]:
    def f[**P](*args: P.args, **kwargs: P.kwargs):
        pass

C[int]()

class D[T]:
    @classmethod
    def f[**P](*args: P.args, **kwargs: P.kwargs):
        pass

D[int]()

[case param_spec_remapping_should_not_cause_crashes]
# From GH #383
from typing import Any, Concatenate, Generic, ParamSpec, TypeVar, Callable

T = TypeVar("T")
_P = ParamSpec("_P")
_Q = ParamSpec("_Q")

def remap_function_arguments(fn: Callable[Concatenate[T, _P], object]) -> Callable[Concatenate[Any, _Q], object]:
    def translated_func(self: Any, *args: _Q.args, **kwargs: _Q.kwargs) -> object:  # E: ParamSpec "_Q" is unbound
        return fn(self, *args, **kwargs)  # E: Argument 2 has incompatible type "*_Q.args"; expected "_P.args"  # E: Argument 3 has incompatible type "**_Q.kwargs"; expected "_P.kwargs"
    return translated_func

[case paramspec_invariance]
# From conformance tests (generics_paramspec_variance.py)
from typing import Callable

class InvariantParamSpec[**InOutP]:
    a: Callable[InOutP, None]

in_out_obj: InvariantParamSpec[object] = InvariantParamSpec[int]()  # E: Incompatible types in assignment (expression has type "InvariantParamSpec[[int]]", variable has type "InvariantParamSpec[[object]]")
in_out_int: InvariantParamSpec[int] = InvariantParamSpec[object]()  # E: Incompatible types in assignment (expression has type "InvariantParamSpec[[object]]", variable has type "InvariantParamSpec[[int]]")

